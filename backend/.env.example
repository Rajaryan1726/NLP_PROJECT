# LLM (any LiteLLM model string). Local Llama: MODEL_NAME=ollama/llama3
MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=sk-your-key-here

# Databases (docker-compose defaults; use Atlas / Qdrant Cloud URLs otherwise)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=factindic
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=

# Mem0 hosted memory
MEM0_API_KEY=m0-your-key-here

# Local models (downloaded from HuggingFace on first start)
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# BAAI/bge-reranker-v2-m3 is the stronger multilingual reranker but ~16x slower on CPU (6.3s vs 0.4s per 14 pairs).
# On English-normalized evidence both rank the same, so the fast one is the default. Use bge if you have a GPU.
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7

# Verification
FACTUALITY_THRESHOLD=7
MAX_RETRIES=2
# claims whose best evidence scores below this (0-1) are marked "unsupported" without NLI
MIN_RERANK_SCORE=0.05
